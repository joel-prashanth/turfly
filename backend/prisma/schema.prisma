generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  PLAYER
  ADMIN
}

enum OwnerStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum BookingSource {
  PLATFORM
  OWNER_MANUAL
}

enum Sport {
  FOOTBALL
  CRICKET
  BADMINTON
  TENNIS
  BASKETBALL
  VOLLEYBALL
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  phone        String
  passwordHash String
  role         Role

  avatarUrl      String?
  avatarPublicId String?
  cooldownUntil  DateTime?
  cooldownReason String?  // LATE_CANCELLATION | NO_SHOW

  notifyNewBooking    Boolean @default(true)
  notifyCancellation  Boolean @default(true)
  notifyDailySummary  Boolean @default(false)

  gstNumber        String?
  businessName     String?
  upiId            String?
  paymentQrUrl      String?
  paymentQrPublicId String?

  ownerStatus       OwnerStatus @default(ACTIVE)
  ownerStatusReason String?

  verificationDocUrl       String?
  verificationDocPublicId  String?
  verificationDocType      String?

  turfs         Turf[]
  bookings      Booking[]
  turfReports   TurfReport[]   @relation("TurfReports")
  notifications Notification[]
  reviews       Review[]       @relation("PlayerReviews")
  waitlist      Waitlist[]     @relation("PlayerWaitlist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turf {
  id           String @id @default(uuid())
  name         String
  description  String
  location     String
  pricePerHour Float

  sport Sport

  imageUrl      String
  imagePublicId String?

  isActive  Boolean @default(true)
  capacity  Int     @default(1)

  lat Float?
  lng Float?

  cancellationWindowHours Int @default(24)

  businessHours Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  slots   Slot[]
  reports TurfReport[]
  reviews Review[]
}

model TurfReport {
  id          String   @id @default(uuid())
  turfId      String
  turf        Turf     @relation(fields: [turfId], references: [id])
  reporterId  String
  reporter    User     @relation("TurfReports", fields: [reporterId], references: [id])
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model Slot {
  id String @id @default(uuid())

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id])

  startTime DateTime
  endTime   DateTime

  status SlotStatus @default(AVAILABLE)

  isWalkIn     Boolean @default(false)
  walkInSlotId String? // set on slots blocked by a walk-in; references the walk-in slot's id

  bookings     Booking[]
  bookingSlots BookingSlot[]
  waitlist     Waitlist[]

  createdAt DateTime @default(now())
}

model BookingSlot {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slotId    String
  slot      Slot    @relation(fields: [slotId], references: [id])
  amount    Float

  @@id([bookingId, slotId])
}

model Booking {
  id String @id @default(uuid())

  playerId String?
  player   User?  @relation(fields: [playerId], references: [id])

  walkInName  String?
  walkInPhone String?

  slotId String
  slot   Slot   @relation(fields: [slotId], references: [id])

  status      BookingStatus @default(PENDING)
  source      BookingSource @default(PLATFORM)
  cancelledAt DateTime?

  amount Float @default(0)

  // Deposit (no-show protection)
  depositAmount     Float?
  depositOrderId    String?
  depositPaymentId  String?
  depositStatus     String? // PENDING | PAID | REFUNDED | FORFEITED

  // Attendance (set by owner after slot)
  attendanceStatus  String? // ATTENDED | NO_SHOW
  attendanceMarkedAt DateTime?

  extraSlots BookingSlot[]
  payment    Payment?
  review     Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  body      String
  read      Boolean  @default(false)

  bookingId String?

  createdAt DateTime @default(now())
}

model Waitlist {
  id       String @id @default(uuid())
  playerId String
  player   User   @relation("PlayerWaitlist", fields: [playerId], references: [id], onDelete: Cascade)
  slotId   String
  slot     Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([playerId, slotId])
}

model Review {
  id        String   @id @default(uuid())

  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])

  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id])

  playerId  String
  player    User     @relation("PlayerReviews", fields: [playerId], references: [id])

  rating    Int      // 1–5
  comment   String?

  ownerReply      String?
  ownerRepliedAt  DateTime?

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(PENDING)

  // Razorpay amount is stored in paise.
  // Example: ₹1200 = 120000.
  amount   Int
  currency String @default("INR")

  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}